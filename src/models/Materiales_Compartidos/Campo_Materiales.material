// Materiales compartidos del campo (un solo archivo, sin duplicados)
material Campo_Linea {
    receive_shadows on
    technique {
        pass {
            cull_hardware none
            depth_bias 40 4
            diffuse 0.85 0.85 0.85 1.0
            specular 0.7 0.0 0 0 0

            // additional maps - requires RTSS
            rtshader_system {
                lighting_stage metal_roughness
            }
        }
    }
}

material Pista_Linea {
    receive_shadows on
    technique {
        pass {
            cull_hardware none
