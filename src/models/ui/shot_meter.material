{
    technique
    {
        pass
        {
            lighting off
            depth_check off
            depth_write off

            texture_unit
            {
                colour_op_ex source1 src_manual src_current 0.2 0.8 0.2
            }
        }
    }
}

material ShotMeter/Red
{
    technique
    {
        pass
        {
